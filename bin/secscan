#!/usr/bin/env python3
"""secscan — ищет секреты в открытом виде и складывает их в СТАГИНГ в /dev/shm (RAM, 0600).

Печатает ТОЛЬКО маскированные значения: ни один пароль не попадает в вывод,
а значит и в переписку с Claude. Полные значения идут в стаг-файл, который
потом шифруется мастер-паролем (его вводит только владелец) и стирается.

  secscan            — сканировать и показать маскированный отчёт
  secscan --json     — путь к стаг-файлу (для sec init)
"""
import json, os, re, sys, time
from pathlib import Path

HOME = Path.home()
UID = os.getuid()
STAGE_DIR = Path(os.environ.get("SECBOX_RAM_DIR") or f"/dev/shm/secbox-{UID}")
STAGE = STAGE_DIR / "staging.json"

# Где ищем. (путь, strict): strict=True — только файлы, где секреты вообще бывают.
# Без strict ~/projects это 15 ГБ и сканер не добегает.
ROOTS = [
    (HOME / "claude-vault", False),
    (HOME / ".claude" / "CLAUDE.md", False),
    (HOME / ".claude" / "skills", False),
    (HOME / ".claude" / "settings.json", False),
    (HOME / "projects", True),
    (HOME / ".ssh", False),
    (HOME / ".aws", False),
    (HOME / ".config" / "rclone", False),
    (HOME / "Desktop", True),
]
SKIP_DIRS = {"node_modules", ".git", "dist", "build", ".next", "venv", ".venv", "env",
             "__pycache__", ".cache", "target", "vendor", ".trash", "site-packages",
             ".tox", ".pytest_cache", ".mypy_cache", ".idea", ".gradle", ".m2", "Pods",
             ".terraform", ".cargo", ".npm", ".yarn", "bower_components", ".angular",
             ".parcel-cache", "coverage", ".nuxt", ".svelte-kit", "out", ".gradle-cache",
             ".vscode-server", "Library", "AppData", ".local", "snap", ".steam",
             # артефакты сборки (Unity и прочие) — генерённый мусор, не секреты
             "Builds", "Temp", "Logs", "obj", "MonoBleedingEdge", "BurstDebugInformation",
             # чужие исходники, которые таскают вместе с проектом
             "third_party", "thirdparty", "external", "googletest", "googlemock", "gtest",
             # прочий генерённый мусор: рантайм Mono, скопированные профили браузера
             "mconfig", "chrome-copy", "WasmTtsEngine", "FPVFreerider_demo_Data"}
SKIP_EXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".mp4", ".mov", ".pdf", ".zip",
            ".gz", ".tar", ".xz", ".woff", ".woff2", ".ttf", ".ico", ".svg", ".mp3", ".wav",
            ".so", ".o", ".a", ".bin", ".exe", ".dll", ".class", ".jar", ".pyc", ".db",
            ".sqlite", ".sqlite3", ".lock", ".map", ".min.js", ".pack", ".whl", ".deb"}
# strict-режим: расширения и имена, в которых секреты реально встречаются
SCAN_EXT = {".env", ".json", ".yml", ".yaml", ".conf", ".cfg", ".ini", ".toml", ".sh",
            ".bash", ".zsh", ".py", ".js", ".ts", ".mjs", ".cjs", ".md", ".txt", ".xml",
            ".properties", ".service", ".tf", ".tfvars", ".sql", ".php", ".rb", ".go", ".java"}
SCAN_NAMES = re.compile(r"(?i)^(\.env|\.env\..*|\.netrc|\.npmrc|\.pypirc|credentials|config|"
                        r"secrets?|settings|docker-compose.*|.*rc|id_[a-z0-9]+|known_hosts|authorized_keys)$")
MAX_BYTES = 3_000_000
MAX_FILES = 60_000
TIME_BUDGET = 240  # секунд на обход; дольше — обрываем и честно говорим

# key = имя параметра, value = сам секрет
KV = re.compile(
    r"""(?ix)
    (?P<key>(?:[A-Za-z0-9_\-\.\s]{0,40}?[_\-\.\s])?
        (?:pass(?:word|wd)?|парол\w*|secret|token|токен|api[_\-\s]?key|apikey|access[_\-\s]?key|
           secret[_\-\s]?key|client[_\-\s]?secret|private[_\-\s]?key|auth[_\-\s]?token|
           bearer|credential|authtoken|app[_\-\s]?secret|webhook|dsn|passphrase)
    )
    \s*[:=]\s*
    (?P<q>["'`]?)(?P<val>[^\s"'`,;<>\|()]{6,200})(?P=q)
    """)

# Самодостаточные форматы токенов — ловим даже без имени параметра
PATTERNS = [
    ("telegram_bot_token", re.compile(r"\b\d{8,12}:AA[A-Za-z0-9_\-]{30,}\b")),
    ("meta_token",        re.compile(r"\bEAA[A-Za-z0-9]{50,}\b")),
    ("openai_key",        re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_\-]{20,}\b")),
    ("anthropic_key",     re.compile(r"\bsk-ant-[A-Za-z0-9_\-]{20,}\b")),
    ("github_token",      re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b")),
    ("aws_access_key",    re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
    ("slack_token",       re.compile(r"\bxox[abprs]-[A-Za-z0-9\-]{10,}\b")),
    ("google_api_key",    re.compile(r"\bAIza[A-Za-z0-9_\-]{35}\b")),
    ("stripe_key",        re.compile(r"\b[sr]k_(?:live|test)_[A-Za-z0-9]{20,}\b")),
    ("cloudflare_token",  re.compile(r"\b[A-Za-z0-9_\-]{40}\b(?=.{0,40}(?i:cloudflare|cf[_\- ]?api))")),
    ("jwt",               re.compile(r"\beyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\b")),
    ("url_with_password", re.compile(r"\b[a-z][a-z0-9+.\-]*://[^\s:@/]+:[^\s:@/]{4,}@[^\s/]+")),
    ("private_key_block", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
]

# Явный мусор: плейсхолдеры, примеры, переменные, пути
NOISE = re.compile(r"""(?ix)
    ^(?:\$|\{|<|%|\*{3,}|x{4,}|\.{3})
  | ^(?:your|my|example|sample|test|dummy|changeme|placeholder|none|null|true|false|
       password|secret|token|value|string|pass|укажи|вставь|сюда|тут|здесь|пароль|xxx)$
  | ^(?:process\.env|os\.environ|env\.|import\.meta)
  | ^(?:z|joi|yup|v|schema|body|req|res|data|input|args|opts|config)\.
  | ^(?:string|number|boolean|integer|object|array|function|const|let|var|return|await|async)$
  | ^(?:true|false|undefined|nan|infinity)$
  | ^\$\{?[A-Z_]+\}?$
  | ^[./~]{1,2}/
  | ^(?:https?://)?(?:localhost|127\.0\.0\.1)
  | ^[-_.]+$
""")

def mask(v: str) -> str:
    v = v.strip()
    n = len(v)
    if n <= 4:
        return "*" * n + f" ({n})"
    return f"{v[:2]}{'*' * min(n - 4, 10)}{v[-2:]} ({n})"

def looks_real(val: str) -> bool:
    v = val.strip()
    if len(v) < 6 or len(v) > 200:
        return False
    if NOISE.search(v):
        return False
    if v.count(" ") > 2:
        return False
    # должна быть хоть какая-то энтропия: цифра+буква, либо длинная строка
    has_d, has_a = any(c.isdigit() for c in v), any(c.isalpha() for c in v)
    return (has_d and has_a) or len(v) >= 16

def wanted(p: Path, strict: bool) -> bool:
    ext = p.suffix.lower()
    if ext in SKIP_EXT:
        return False
    if not strict:
        return True
    return ext in SCAN_EXT or bool(SCAN_NAMES.match(p.name)) or p.name.startswith(".env")


def iter_files(progress=None):
    started, seen = time.time(), 0
    for root, strict in ROOTS:
        if not root.exists():
            continue
        if root.is_file():
            yield root
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            depth = len(Path(dirpath).relative_to(root).parts)
            # Вложенный чужой репозиторий (свой .git на глубине ≥2) — это не наш код и не наши
            # секреты: ardupilot, форки, вендоренные библиотеки. Свои проекты (~/projects/X,
            # глубина 1) при этом остаются.
            dirnames[:] = [d for d in dirnames
                           if d not in SKIP_DIRS and not d.startswith(".venv")
                           and not (depth >= 1 and (Path(dirpath) / d / ".git").exists())]
            for fn in filenames:
                p = Path(dirpath) / fn
                if not wanted(p, strict):
                    continue
                try:
                    if p.is_symlink() or not p.is_file() or p.stat().st_size > MAX_BYTES:
                        continue
                except OSError:
                    continue
                seen += 1
                if progress and seen % 1500 == 0:
                    progress(seen, time.time() - started, dirpath)
                if seen > MAX_FILES or time.time() - started > TIME_BUDGET:
                    if progress:
                        progress(seen, time.time() - started, "ОБРЫВ: лимит времени/файлов")
                    return
                yield p

def scan(progress=None):
    found, seen = [], set()
    for p in iter_files(progress):
        try:
            text = p.read_text("utf-8", errors="ignore")
        except OSError:
            continue
        priv_key_file = False
        for i, line in enumerate(text.splitlines(), 1):
            if len(line) > 4000:
                continue
            hits = []
            for m in KV.finditer(line):
                key = re.sub(r"[^A-Za-z0-9_.\-]+", "_", m.group("key").strip()).strip("_").lower()
                hits.append((key or "secret", m.group("val"), "kv"))
            for name, rx in PATTERNS:
                for m in rx.finditer(line):
                    if name == "private_key_block":
                        priv_key_file = True
                        continue
                    hits.append((name, m.group(0), "pattern"))
            for key, val, how in hits:
                if not looks_real(val):
                    continue
                sig = (val.strip(), key)
                if sig in seen:
                    continue
                seen.add(sig)
                found.append({
                    "file": str(p), "line": i, "key": key, "value": val.strip(),
                    "how": how, "context": line.strip()[:120],
                })
        if priv_key_file:
            found.append({"file": str(p), "line": 0, "key": "private_key_file",
                          "value": f"@FILE:{p}", "how": "file", "context": "приватный ключ целиком"})
    return found

def main():
    quiet = "--json" in sys.argv

    def progress(n, secs, where):
        if not quiet:
            print(f"  … просмотрено {n} файлов за {secs:.0f} с — {str(where)[:70]}", file=sys.stderr)

    found = scan(progress)
    STAGE_DIR.mkdir(mode=0o700, exist_ok=True)
    os.chmod(STAGE_DIR, 0o700)
    with open(os.open(STAGE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(found, f, ensure_ascii=False, indent=1)

    if "--json" in sys.argv:
        print(STAGE)
        return

    by_file = {}
    for h in found:
        by_file.setdefault(h["file"], []).append(h)
    print(f"Найдено потенциальных секретов: {len(found)} в {len(by_file)} файлах")
    print(f"Стаг-файл (RAM, 0600): {STAGE}\n")
    for f, hits in sorted(by_file.items(), key=lambda kv: -len(kv[1])):
        short = f.replace(str(HOME), "~")
        print(f"{short}  [{len(hits)}]")
        for h in hits[:14]:
            print(f"   :{h['line']:<5} {h['key'][:34]:<34} {mask(h['value'])}")
        if len(hits) > 14:
            print(f"   … ещё {len(hits) - 14}")

if __name__ == "__main__":
    main()
